{
  "seed": 42,
  "subsample": 1.0,
  "selection_rule": "Rank by grouped-CV observation Top-1 (higher is better); break ties with grouped-CV macro F1, then with lower student-test inference time.",
  "features": [
    "distance_m",
    "candidate_rank",
    "outside_radius",
    "arc_length_m",
    "arc_fraction",
    "distance_from_arc_start_m",
    "distance_to_arc_end_m",
    "arc_bearing_deg",
    "gps_heading_deg",
    "heading_difference_deg",
    "dt_s",
    "gps_step_m",
    "gps_speed_m_s",
    "from_out_degree",
    "to_in_degree"
  ],
  "fit_filter": "training_group_usable == 1",
  "label_status": "approximate reference-route alignment; not independently verified point labels",
  "threshold": 0.5,
  "prob_floor": 1e-06,
  "versions": {
    "python": "3.13.7",
    "sklearn": "1.9.1",
    "pandas": "3.1.1",
    "numpy": "2.5.5"
  },
  "machine": {
    "platform": "Windows-11-10.0.26300-SP0",
    "processor": "Intel64 Family 6 Model 154 Stepping 3, GenuineIntel"
  },
  "models": {
    "logreg": {
      "family": "Linear",
      "config": {
        "C": 1.0,
        "penalty": "l2",
        "scaler": "standard",
        "max_iter": 300
      }
    },
    "gaussian_nb": {
      "family": "Probabilistic",
      "config": {
        "var_smoothing": 1e-09
      }
    },
    "extra_trees": {
      "family": "Tree ensemble",
      "config": {
        "n_estimators": 100,
        "max_depth": 16,
        "min_samples_leaf": 20
      }
    },
    "hist_gb": {
      "family": "Boosting",
      "config": {
        "learning_rate": 0.1,
        "max_iter": 200,
        "max_leaf_nodes": 31
      }
    },
    "mlp": {
      "family": "Neural network",
      "config": {
        "hidden": [
          64,
          32
        ],
        "solver": "adam",
        "max_iter": 40,
        "scaler": "standard"
      }
    }
  }
}